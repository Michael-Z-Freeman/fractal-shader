#pragma kernel CSMain

// Core Render Textures
RWTexture2D<float4> Texture;
Texture2D<float4> Source;

// Screen and Depth variables
float W; // Screen Width
float H; // Screen Height
float FocalPlane; // The distance from the camera that is in perfect focus
float Strength; // Intensity of the blur effect

// Constants
static const float PI = 3.14159265f;
static const float E = 2.7182818284f;

/// <summary>
/// 2D Gaussian function used to calculate the weight of a pixel based on distance.
/// Formula: G(x,y) = (1 / (2 * PI * sigma^2)) * e^(- (x^2 + y^2) / (2 * sigma^2))
/// </summary>
float Gaussian(float2 pos, float sigma)
{
    float sigma2 = pow(sigma, 2.0);
    float distanceSq = dot(pos, pos); // Equivalent to length(pos)^2 but slightly faster
    float coefficient = 1.0 / (2.0 * PI * sigma2);
    float exponent = -distanceSq / (2.0 * sigma2);
    return coefficient * pow(E, exponent);
}

/// <summary>
/// Ensures pixel lookups stay within the valid screen texture bounds.
/// </summary>
int2 ClampPosition(int2 pos)
{
    return clamp(pos, int2(0, 0), int2((int) W - 1, (int) H - 1));
}

/// <summary>
/// Samples the surrounding pixels and applies the Gaussian weight to return a blurred color.
/// Note: Kernel size (a) increases with the blur 'size', impacting performance.
/// </summary>
float4 GetBlurredColor(int2 pos, float size)
{
    float4 color = 0;
    int kernelSize = (int) (size * 3.0); // 3-sigma rule for Gaussian accuracy
    
    for (int i = -kernelSize; i <= kernelSize; i++)
    {
        for (int j = -kernelSize; j <= kernelSize; j++)
        {
            color += Source[ClampPosition(pos + int2(i, j))] * Gaussian(float2(i, j), size);
        }
    }
    
    return color;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{

    // Retrieve distance from the alpha/w channel (standard for your framework's raymarchers)
    // Multiplied by 10.0 to match the world-space scale used in the App controllers
    float distance = Source[id.xy].w * 10.0;
    
    // Calculate the blur amount based on the distance from the focal plane
    // Points closer to FocalPlane have a smaller 'd' (less blur)
    float blurAmount = abs(distance - FocalPlane) * Strength + 1.0;

    // Execute the Gaussian sampling
    // Clamped between 1 and 7 to prevent GPU timeout at high strengths
    Texture[id.xy] = GetBlurredColor(int2(id.xy), clamp(blurAmount, 1.0, 7.0));
}