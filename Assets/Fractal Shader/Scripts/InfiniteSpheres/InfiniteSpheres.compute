#pragma kernel CSMain

RWTexture2D<float4> Texture;
Texture2D<float4> Source;

float Radius;
int Repeat;
int Invert;

float4 SphereColor;
float4 BackgroundColor;
float EmissionStrength;
float FogDensity;
float MaxDistance;

uint _Width;
uint _Height;

float4x4 CamToWorld;
float4x4 CamInverseProjection;

struct Ray
{
    float3 origin;
    float3 direction;
};

float3 RepeatSpace(float3 p)
{
    float spacing = max(Radius * 2.5, 4.0); // Küreler arası dinamik boşluk
    return p - spacing * floor(p / spacing + 0.5);
}

float DEMain(float3 pos)
{
    if (Repeat == 1)
        pos = RepeatSpace(pos);
    
    // Küre merkezini (0,0,0) baz alarak mesafe hesapla
    float dst = length(pos) - Radius;
    
    if (Invert == 1)
        dst *= -1.0;
    return dst;
}

float3 GetNormal(float3 p)
{
    float2 e = float2(0.001, 0.0);
    return normalize(float3(
        DEMain(p + e.xyy) - DEMain(p - e.xyy),
        DEMain(p + e.yxy) - DEMain(p - e.yxy),
        DEMain(p + e.yyx) - DEMain(p - e.yyx)
    ));
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height)
        return;
    
    float2 uv = (float2(id.xy) / float2(_Width, _Height) * 2.0 - 1.0);
    
    // Camera Ray Setup
    float3 ro = mul(CamToWorld, float4(0, 0, 0, 1)).xyz;
    float3 rd = mul(CamInverseProjection, float4(uv, 0, 1)).xyz;
    rd = normalize(mul(CamToWorld, float4(rd, 0)).xyz);
    
    float totalDist = 0.0;
    bool hit = false;
    
    for (int i = 0; i < 128; i++)
    {
        float3 p = ro + rd * totalDist;
        float dst = DEMain(p);
        if (dst < 0.001)
        {
            hit = true;
            break;
        }
        totalDist += dst;
        if (totalDist > MaxDistance)
            break;
    }
    
    if (hit)
    {
        float3 p = ro + rd * totalDist;
        float3 normal = GetNormal(p);
        float diff = max(0.2, dot(normal, normalize(float3(1, 1, -1))));
        
        float3 color = SphereColor.rgb * diff * EmissionStrength;
        float fog = saturate(totalDist / FogDensity);
        Texture[id.xy] = float4(lerp(color, BackgroundColor.rgb, fog), 1.0);
    }
    else
    {
        Texture[id.xy] = BackgroundColor;
    }
}