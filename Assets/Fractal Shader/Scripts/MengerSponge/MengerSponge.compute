#pragma kernel CSMain

// Core Render Textures
RWTexture2D<float4> Texture;
Texture2D<float4> Source;

// Camera Matrices
float4x4 CamToWorld;
float4x4 CamInverseProjection;

// Fractal Parameters
int Iterations;
float Size;
float Edge;
float Cut;
int Cantor; // Toggle for Cantor-set logic modification (serves as crash protection)

// Screen Dimensions
uint _Width;
uint _Height;

// Raymarching Constants
static const int steps = 300;
static const float epsilon = 0.00001;

struct Ray
{
    float3 origin;
    float3 direction;
};

Ray CreateRay(float3 origin, float3 direction)
{
    Ray ray;
    ray.origin = origin;
    ray.direction = direction;
    return ray;
}

// Generates a ray from the camera position through the pixel UV
Ray CreateCameraRay(float2 uv)
{
    float3 origin = mul(CamToWorld, float4(0, 0, 0, 1)).xyz;
    float3 direction = mul(CamInverseProjection, float4(uv, 0, 1)).xyz;
    direction = mul(CamToWorld, float4(direction, 0)).xyz;
    direction = normalize(direction);
    return CreateRay(origin, direction);
}

// Standard Signed Distance Field (SDF) for a 3D Box
float DEBox(float3 p, float s)
{
    float3 q = abs(p) - float3(s, s, s);
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

// 2D Box SDF used for cross-sections. 
// Modified by 'Cantor' logic to alter the folding pattern.
float DEBox2D(float2 p, float s)
{
    float2 d = abs((Cantor == 1) ? float2(p.x, p.x) : p) - s;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}

// Creates an infinite cross-shaped void used to carve the Menger Sponge holes
float DECross(float3 p, float s)
{
    s = s / 3.0;
    float d = DEBox2D(p.xy, s);
    d = min(d, DEBox2D(p.zx, s));
    return min(d, DEBox2D(p.yz, s));
}

// Distance estimator for the cutting plane
float DECuttingPlane(float3 p)
{
    float3 n = normalize(float3(1.0, -1.0, 1.0));
    return dot(p, n) - (Cut * 2.0 - 1.0) * length(float3(Size, Size, Size));
}

// Core Menger Sponge Distance Estimator
float2 DE(float3 p)
{
    float plane = DECuttingPlane(p);
    float d = DEBox(p, Size / Edge);
    
    // Recursive space folding to create the Menger Sponge structure
    for (int i = 0; i < Iterations; i++)
    {
        // Subtract infinite crosses from the current box volume
        d = max(d, -DECross(p, Size) / pow(3.0, (float) i));
        
        // Scale and fold space
        p *= 3.0;
        p = abs(p);
        p -= float3(Size, Size, Size);
        p = abs(p);
        p -= float3(Size, Size, Size);
    }
    
    // Intersection with the cutting plane
    d = max(d, -plane);
    
    // Edge highlighting logic for the cross-section
    float c = (d < 0.001 && abs(d - plane) < 0.001) ? 1.0 : 0.0;
    return float2(d, c);
}

// Primary Raymarching Loop
float2 March(Ray ray)
{
    float2 d = float2(0, 0);
    float3 eye = ray.origin;
    
    int s = 0;
    while (s < steps)
    {
        d = DE(ray.origin);
        
        // Max view distance check
        if (length(eye - ray.origin) > 200.0)
            break;
            
        // Surface hit detection
        if (d.x < epsilon)
            break;
            
        ray.origin += ray.direction * d.x;
        s++;
    }
    
    // Returns normalized step count + color logic, and total distance
    return float2((float) s / (float) steps + d.y, length(eye - ray.origin));
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    // Screen bounds check to prevent GPU freezing
    if (id.x >= _Width || id.y >= _Height)
        return;
        
    // Convert pixel coordinates to Normalized Device Coordinates (-1.0 to 1.0)
    float2 uv = float2(id.xy) / float2((float) _Width, (float) _Height) * 2.0 - 1.0;
    
    Ray ray = CreateCameraRay(uv);
    ray.origin += ray.direction * 0.1; // Ray offset to prevent immediate self-intersection
    
    float2 res = March(ray);
    
    // Surface color logic (Distance < Far Clip)
    if (res.y < 200.0)
    {
        // Shading based on step count and original blue-cyan theme
        float4 ao = res.x * float4(0.3, 0.6, 0.7, 1.0);
        
        // ANTI-GHOSTING: Output a clean black background instead of accumulating previous frames
        Texture[id.xy] = float4(0.0, 0.0, 0.0, 1.0) + ao;
    }
    else
    {
        // Background color (Infinity)
        Texture[id.xy] = float4(0.0, 0.0, 0.0, 1.0);
    }
}